/**
 * Configuración de Wrangler: https://developers.cloudflare.com/workers/wrangler/configuration/
 * Los secretos (tokens, client secrets) NO van aquí: se cargan con `wrangler secret put`.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mycontent-google-ads-mcp",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"migrations": [{ "new_sqlite_classes": ["GoogleAdsMCP"], "tag": "v1" }],
	"durable_objects": {
		"bindings": [{ "class_name": "GoogleAdsMCP", "name": "MCP_OBJECT" }]
	},
	"kv_namespaces": [
		// Estado del proveedor OAuth (clientes, grants, tokens).
		{ "binding": "OAUTH_KV", "id": "ffd172bc7fe04bd18a5e47c87b41d692" },
		// Planes de cambio (TTL 30 min) y registro de auditoría.
		{ "binding": "STATE_KV", "id": "4452ee2559d14f218d70a1258f76f58b" }
	],
	"vars": {
		"GOOGLE_ADS_LOGIN_CUSTOMER_ID": "2567236642",
		"ALLOWED_CUSTOMER_IDS": "*",
		"ALLOWED_EMAILS": "ivan@mycontent.agency",
		"MAX_DAILY_BUDGET": "60",
		"MAX_BUDGET_INCREASE_PCT": "100",
		// URL pública del Worker (audiencia OAuth). Vacía = origen de la petición.
		"PUBLIC_BASE_URL": "https://googleads-mcp.mycontent.academy"
	},
	// Dominio propio (zona mycontent.academy en esta cuenta). Es la URL canónica y la audiencia OAuth;
	// workers.dev se desactiva para que solo exista una URL válida.
	"routes": [{ "pattern": "googleads-mcp.mycontent.academy", "custom_domain": true }],
	"workers_dev": false,
	"observability": { "enabled": true },
	"dev": { "port": 8788 }
}
